#!/usr/bin/env bash
# agent-coherence Node coordinator: SessionStart bootstrap + lazy launch.
#
# Implements the officially-documented Claude Code plugin pattern for native
# Node dependencies per `code.claude.com/docs/en/plugins-reference` § ${CLAUDE_PLUGIN_DATA}:
# install deps lazily into PLUGIN_DATA on first use; persist across plugin
# updates; retry on next session if install fails.
#
# Why this script copies BOTH package.json AND dist/ to PLUGIN_DATA (vs the
# documented snippet which only copies package.json + relies on NODE_PATH):
# the coordinator uses ESM (`"type": "module"` in package.json), and Node's
# ESM resolver does NOT honor NODE_PATH — it walks the import tree from the
# importing file's directory. Putting dist/ under PLUGIN_DATA puts
# coordinator.js in the same tree as node_modules, so `import "better-sqlite3"`
# resolves cleanly.
#
# Where dist/ comes from: a marketplace install is a git clone, and dist/ is
# gitignored — so NO released package contains compiled output (the release
# workflow's dist.tar.gz is a GitHub-Release asset the marketplace flow never
# consumes). When ${CLAUDE_PLUGIN_ROOT}/dist is absent, Stage 2 therefore
# BUILDS src/ → PLUGIN_DATA/dist at provision time, with the tsc that Stage
# 1's dev-inclusive `npm install` (or the installer's own npm install in the
# plugin cache) provides. Before this landed, Stage 4 spawned a nonexistent
# entry point and reported success while the coordinator crash-looped
# MODULE_NOT_FOUND into coordinator.log — a silent no-op of every hook
# surface on exactly the fresh installs the Node default exists to serve.
#
# Selected by bin/ensure-coordinator-dispatch at SessionStart when the
# backend resolves to `node` (env > .coherence/coordinator_backend file >
# guarded default; see that script's header).

set -uo pipefail

# CLAUDE_PLUGIN_ROOT and CLAUDE_PLUGIN_DATA are provided by Claude Code per
# the plugin spec. Bail loudly if invoked outside that context — useful for
# local development to catch missing-env mistakes early.
: "${CLAUDE_PLUGIN_ROOT:?CLAUDE_PLUGIN_ROOT must be set by Claude Code; invoke via a SessionStart hook}"
: "${CLAUDE_PLUGIN_DATA:?CLAUDE_PLUGIN_DATA must be set by Claude Code; invoke via a SessionStart hook}"

mkdir -p "${CLAUDE_PLUGIN_DATA}"

# Workspace resolution (per-workspace state per KTD-C) + a virgin-store
# marker for the post-spawn backend stamp. The marker MUST be read before
# Stage 4 — the coordinator's own first boot creates state.db within
# milliseconds, which would make every workspace look established. Read
# before Stage 0 too, which keys its Python-backend hint on it.
WORKSPACE="${AGENT_COHERENCE_WORKSPACE:-$PWD}"
PIDFILE="${WORKSPACE}/.coherence/server.pid"
workspace_had_state_db=0
if [ -f "${WORKSPACE}/.coherence/state.db" ]; then
  workspace_had_state_db=1
fi

# The Python backend is a fallback only while the workspace has no store: the
# Python coordinator creates its own, but fails closed on a state.db the Node
# coordinator created, and no tool converts a store between backends. With a
# store present this script runs only on an explicit `node` choice, so the
# store is most likely the Node coordinator's — the hint must not prescribe
# the switch there, or following it leaves the workspace with no coordinator.
python_backend_hint() {
  if [ "$workspace_had_state_db" = "0" ]; then
    echo "agent-coherence: alternatively, select the Python backend: mkdir -p '${WORKSPACE}/.coherence' && echo python > '${WORKSPACE}/.coherence/coordinator_backend'"
  else
    echo "agent-coherence: ${WORKSPACE}/.coherence/state.db exists, so select the Python backend only if the Python coordinator created it: it refuses a store the Node coordinator created, and no tool converts one."
  fi
}

# Stage 0: Node-ABI preflight. The zero-Python guarantee (decision B) holds
# only where better-sqlite3 ships a prebuilt binary for this Node ABI; on any
# other major, Stage 1's `npm install` falls back to node-gyp — which needs
# Python and a C++ toolchain, the exact dependencies this backend exists to
# avoid. better-sqlite3 12.10.0 dropped the Node 20 (ABI 115) and Node 23
# (ABI 131) prebuilts, so the supported majors are 22 / 24 / 25 (ABIs
# 127 / 137 / 141). KEEP IN SYNC with engines.node in package.json and the
# dispatcher's node_abi_supported() — package.json stays the enforced source
# of truth via --engine-strict on the install below.
NODE_VERSION_RAW="$(node --version 2>/dev/null || echo unknown)"
NODE_MAJOR="$(printf '%s' "$NODE_VERSION_RAW" | sed -n 's/^v\{0,1\}\([0-9][0-9]*\)\..*$/\1/p')"
case "$NODE_MAJOR" in
  22 | 24 | 25) ;;
  *)
    {
      echo "agent-coherence: Node ${NODE_VERSION_RAW} is not supported by the Node coordinator."
      echo "agent-coherence: better-sqlite3 ships prebuilt binaries only for Node 22, 24, and 25;"
      echo "agent-coherence: other majors fall back to node-gyp (Python + C++ toolchain), which the"
      echo "agent-coherence: zero-Python install guarantee forbids. Install Node 22 or 24 (LTS)."
      python_backend_hint
    } >&2
    exit 1
    ;;
esac

# The running Node's ABI (`process.versions.modules`) is what a compiled
# better_sqlite3.node is actually bound to — 131 for Node 23, 137 for Node
# 24 — and a binary built for one is a hard load error under the other. It
# is the provisioning key package.json cannot express; see Stage 1.
NODE_ABI="$(node -p 'process.versions.modules' 2>/dev/null || echo unknown)"
ABI_STAMP="${CLAUDE_PLUGIN_DATA}/.node-abi"

# Does the provisioned native addon actually load under THIS node?
#
# Deliberately CONSTRUCTS a Database: better-sqlite3 resolves its addon
# through `bindings` at first use, not at require time, so a bare
# `require("better-sqlite3")` exits 0 even when the .node file is missing or
# ABI-stale — a probe keyed on require alone passes in exactly the broken
# states it exists to catch.
#
# Keyed on what the provisioned package.json DECLARES, not on what resolves:
# a package that never depended on better-sqlite3 (the provisioning tests'
# zero-dependency stub) is healthy by definition, while one that declares it
# and cannot resolve it is broken — an unresolvable-means-fine probe would
# call a wiped node_modules healthy.
native_module_loads() {
  (
    cd "${CLAUDE_PLUGIN_DATA}" 2>/dev/null || exit 1
    node -e '
      const deps = require("./package.json").dependencies || {};
      if (!deps["better-sqlite3"]) process.exit(0);
      new (require("better-sqlite3"))(":memory:").close();
    '
  ) >/dev/null 2>&1
}

# Stage 1: lazy `npm install`, keyed on BOTH signals that can invalidate the
# provisioned tree:
#
#   (a) package.json differs — initial install or package update. The
#       documented pattern, with the fail-then-rm-marker recovery for
#       next-session retry. `deps_changed` keys Stage 2's rebuild the same
#       way the diff keys the install.
#   (b) the Node ABI differs from the one the tree was provisioned under. A
#       compiled better_sqlite3.node is bound to process.versions.modules,
#       which package.json cannot express — so (a) alone is blind to a user
#       installing a new Node major, and the coordinator crash-loops
#       "compiled against a different Node.js version using
#       NODE_MODULE_VERSION 131 ... requires NODE_MODULE_VERSION 137"
#       forever, with no session ever repairing it. Worse, (a) firing does
#       NOT repair it either: npm sees better-sqlite3 already present at a
#       satisfying version and leaves the stale binary untouched, so the
#       0.3.1 -> 0.4.0 package bump ran a full install and still shipped an
#       ABI-131 binary to a Node 24 user.
#
# On (b) the node_modules tree is TORN DOWN rather than installed over: a
# clean install is what makes prebuild-install refetch the prebuilt for this
# ABI. `npm rebuild` is deliberately not used — it compiles from source via
# node-gyp, which needs Python and a C++ toolchain, the exact dependencies
# decision B's zero-Python guarantee forbids.
deps_changed=0
if ! diff -q "${CLAUDE_PLUGIN_ROOT}/package.json" "${CLAUDE_PLUGIN_DATA}/package.json" >/dev/null 2>&1; then
  deps_changed=1
fi

# Native gate: is the provisioned tree valid for THIS node?
#
# A stamp from a previous successful provision is the cheap answer, and it
# is read only OVER a populated node_modules — a stamp left behind by a
# hand-deleted tree vouches for nothing, and taking its word would wave a
# MODULE_NOT_FOUND crash loop straight through. Anything else (a tree from
# before this gate existed, one the liveness gate below invalidated, one
# whose node_modules is gone) is settled by probing rather than reinstalling
# blindly: a healthy legacy tree then costs only a stamp backfill — no
# network, no reinstall — while a genuinely stale one is rebuilt.
native_stale=0
stamped_abi=""
if [ -d "${CLAUDE_PLUGIN_DATA}/node_modules" ]; then
  stamped_abi="$(cat "$ABI_STAMP" 2>/dev/null || true)"
fi
if [ -n "$stamped_abi" ]; then
  if [ "$stamped_abi" != "$NODE_ABI" ]; then
    native_stale=1
    echo "agent-coherence: Node ABI changed (${stamped_abi} -> ${NODE_ABI}); reinstalling native deps" >&2
  fi
elif [ "$deps_changed" = "0" ]; then
  # No usable stamp and no install already queued — probe. (An install about
  # to run makes the answer moot, so the common first-provision path pays
  # nothing for this.)
  if native_module_loads; then
    printf '%s\n' "$NODE_ABI" >"$ABI_STAMP"
  else
    native_stale=1
    echo "agent-coherence: provisioned native addon does not load under Node ${NODE_VERSION_RAW} (ABI ${NODE_ABI}); reinstalling" >&2
  fi
fi

if [ "$deps_changed" = "1" ] || [ "$native_stale" = "1" ]; then
  echo "agent-coherence: installing Node deps into ${CLAUDE_PLUGIN_DATA}" >&2
  cp "${CLAUDE_PLUGIN_ROOT}/package.json" "${CLAUDE_PLUGIN_DATA}/" || exit 1
  if [ -f "${CLAUDE_PLUGIN_ROOT}/package-lock.json" ]; then
    cp "${CLAUDE_PLUGIN_ROOT}/package-lock.json" "${CLAUDE_PLUGIN_DATA}/" || true
  fi
  # Clear the stamp BEFORE the install, not just rewrite it after: if the
  # install dies partway, the next session must see "unstamped" and probe —
  # never a stamp vouching for a tree that was torn down.
  rm -f "$ABI_STAMP"
  if [ "$native_stale" = "1" ]; then
    rm -rf "${CLAUDE_PLUGIN_DATA}/node_modules"
  fi
  # --engine-strict turns the engines.node range into a hard install-time
  # gate (npm only warns by default), so the Stage-0 list above can never
  # silently drift past package.json.
  # Capture as well as show, so the failure below can be CLASSIFIED rather
  # than guessed at. PIPESTATUS[0] is npm's status; $? would be tee's.
  npm_log="$(mktemp "${TMPDIR:-/tmp}/agent-coherence-npm.XXXXXX" 2>/dev/null || echo "")"
  # The in-line `rm`s below cover the ordinary exits; this covers the ones
  # that skip them. A cold `npm install` regularly outruns the SessionStart
  # hook's time box, and without the trap every timed-out provision leaves a
  # full npm log behind in TMPDIR.
  trap 'rm -f "$npm_log"' EXIT
  if [ -n "$npm_log" ]; then
    # --loglevel=http is what makes the failure below CLASSIFIABLE: npm passes
    # it down as npm_config_loglevel, and prebuild-install gates its own
    # `log.http(res.statusCode, url)` on exactly that (its log.js defaults to
    # 'notice', above which http is dropped). Without it the HTTP status of a
    # failed asset fetch is never printed by anyone and cannot be recovered
    # afterwards -- not even from npm's debug log, which can only capture what
    # the child chose to emit.
    #
    # The `grep -v` filters the DISPLAY, never the captured log. At http level
    # npm logs one `cache`/`fetch GET 200` line per package: measured 148
    # lines / 16KB warm and 298 / 31KB cold on this repo's own tree. This
    # script's stdout is a SessionStart hook's stdout, so that lands in the
    # model's context, where 31KB of registry chatter is several times the
    # 10,000-byte ceiling and would evict the very diagnostic it came for.
    # Filtered, the visible output matches an unflagged run except for npm's
    # own "added N packages in Xs" duration line, which differs between any
    # two runs regardless of this flag -- measured, not assumed.
    # prebuild-install's own lines survive because npm prefixes them
    # `npm error `, not `npm http `.
    #
    # tee BEFORE grep is deliberate, and is defensive rather than currently
    # load-bearing: no classifier input is filter-shaped today, so swapping
    # the two would change nothing observable. It matters the moment either
    # side moves -- a broader filter, or an npm that stops prefixing a
    # script's output -- at which point capturing first is what keeps the
    # classifier reading everything npm said while the operator reads less.
    # The two alternatives below are a snapshot of npm's http vocabulary;
    # a third shape would leak noise to the display, never hide a diagnostic.
    (cd "${CLAUDE_PLUGIN_DATA}" && npm install --engine-strict --no-audit --no-fund --no-progress --loglevel=http 2>&1) \
      | tee "$npm_log" | grep -v '^npm http \(cache\|fetch GET 200\)'
    # Must stay on the line immediately after the pipeline: PIPESTATUS is
    # clobbered by the next command. Still index 0 through three stages.
    npm_status=${PIPESTATUS[0]}
  else
    (cd "${CLAUDE_PLUGIN_DATA}" && npm install --engine-strict --no-audit --no-fund --no-progress 2>&1)
    npm_status=$?
  fi
  if [ "$npm_status" -ne 0 ]; then
    rm -f "${CLAUDE_PLUGIN_DATA}/package.json"
    echo "agent-coherence: npm install failed; coordinator will not start this session. Next session retries." >&2
    # WHY CLASSIFY, and why the order below is load-bearing. Every failure
    # here ends in the same node-gyp "find Python" trace, because
    # better-sqlite3 falls back to compiling whenever it cannot place a
    # prebuilt binary -- for ANY reason. This block used to assert the first
    # explanation unconditionally, which sent the reader to check their Node
    # version even when the real cause was a dropped connection.
    #
    # ESTRICTALLOWSCRIPTS is tested FIRST because it is a terminal npm error
    # code rather than a warning: a log carrying it is that failure whatever
    # prebuild-install managed to log on the way, and with more than one
    # native dependency both can appear.
    if [ -z "$npm_log" ]; then
      # Say what happened, not what we guess. mktemp failed, so npm's output
      # was never captured and nothing was examined.
      echo "agent-coherence: (npm's output could not be captured — mktemp failed — so no" >&2
      echo "agent-coherence: cause was classified. The usual three are a missing prebuilt for" >&2
      echo "agent-coherence: this platform, a failed prebuilt download, and an" >&2
      echo "agent-coherence: ESTRICTALLOWSCRIPTS block on the install script.)" >&2
    elif grep -q 'ESTRICTALLOWSCRIPTS' "$npm_log"; then
      echo "agent-coherence: cause: npm 11 blocked an install script. The allowScripts entry in" >&2
      echo "agent-coherence: package.json covers better-sqlite3's prebuilt fetch, so a NEW package" >&2
      echo "agent-coherence: there needs adding to it." >&2
    elif grep -qiE 'prebuild-install.+warn.+install.+No prebuilt binaries found' "$npm_log"; then
      # "No prebuilt binaries found" does NOT mean the ABI is unsupported. It
      # is also what prebuild-install reports for any non-200 response:
      # download.js does `if (res.statusCode !== 200) return onerror()` with
      # no argument, and onerror falls through to `error.noPrebuilts(opts)`.
      # The message's own `target=` field is the discriminator, and Stage 0
      # has already refused to get here on an unsupported major -- so when
      # they agree, the major is fine and the prebuilt simply could not be
      # placed. The HTTP status separates a missing asset from a transient
      # 5xx, and the install above now asks for it (--loglevel=http). It is
      # absent only when the capture itself failed, and that case says so
      # instead of guessing.
      target_major="$(sed -n 's/.*No prebuilt binaries found (target=v\{0,1\}\([0-9][0-9]*\)\..*/\1/p' "$npm_log" | head -n 1)"
      # simple-get follows 3xx before the callback, so exactly one numeric
      # line is logged per download and it carries the FINAL status;
      # `http request GET …` has a non-numeric second token and cannot match.
      #
      # `tail -n 1` is unambiguous because better-sqlite3 is the ONLY
      # prebuild-install consumer in this tree (one install script:
      # `prebuild-install || node-gyp rebuild --release`). Add a second
      # prebuilt-using native dependency and that stops holding: a sibling's
      # `http 200` could be read as the status for better-sqlite3's own 404,
      # printing "the server said 200 ... transient: RETRY". If that day comes,
      # scope the match to the failing package rather than taking the last line.
      http_status="$(sed -n 's/.*prebuild-install http \([0-9][0-9][0-9]\) .*/\1/p' "$npm_log" | tail -n 1)"
      if [ -n "$target_major" ] && [ "$target_major" != "$NODE_MAJOR" ]; then
        echo "agent-coherence: cause: no better-sqlite3 prebuilt for Node ${target_major}." >&2
        echo "agent-coherence: supported majors are 22 / 24 / 25; running ${NODE_VERSION_RAW}." >&2
        echo "agent-coherence: retrying will not help — switch Node majors." >&2
      elif [ "$http_status" = "404" ]; then
        # Deliberately not called permanent: a release can 404 mid-publish, an
        # unsynced binary-host mirror 404s, and blocking proxies 404 the hosts
        # they disallow.
        echo "agent-coherence: cause: no prebuilt is published for this platform (asset 404)." >&2
        echo "agent-coherence: Node ${NODE_VERSION_RAW} is supported, so this is NOT your Node version —" >&2
        echo "agent-coherence: it is this platform/arch/libc. A retry is unlikely to help. Two things" >&2
        echo "agent-coherence: also produce a 404 here: a binary-host mirror that has not synced, and a" >&2
        echo "agent-coherence: proxy or firewall that 404s the release host rather than refusing it." >&2
      elif [ "$http_status" = "429" ] || case "$http_status" in 5??) true ;; *) false ;; esac; then
        echo "agent-coherence: cause: the prebuilt download failed — the server said ${http_status}." >&2
        echo "agent-coherence: Node ${NODE_VERSION_RAW} is supported and the asset exists; the node-gyp" >&2
        echo "agent-coherence: trace after it is the fallback failing, not the cause." >&2
        echo "agent-coherence: This is transient: RETRY." >&2
      elif [ -n "$http_status" ]; then
        # Everything else -- 401, 403, 451 -- is a refusal, not a wobble.
        # Saying "transient: RETRY" here sends an operator behind a blocking
        # proxy round a loop that can never succeed.
        echo "agent-coherence: cause: the prebuilt download was refused — the server said ${http_status}." >&2
        echo "agent-coherence: Node ${NODE_VERSION_RAW} is supported and this is not a wobble: a proxy," >&2
        echo "agent-coherence: firewall or auth token blocking the release host produces this." >&2
        echo "agent-coherence: Retrying unchanged will not help." >&2
      else
        echo "agent-coherence: cause: a better-sqlite3 prebuilt could not be placed for this platform." >&2
        echo "agent-coherence: Node ${NODE_VERSION_RAW} is supported, so this is NOT your Node version." >&2
        echo "agent-coherence: No HTTP status was captured, so a missing asset and a transient failure" >&2
        echo "agent-coherence: cannot be told apart here — try ONE retry before concluding either." >&2
      fi
    elif grep -qiE 'prebuild-install.+warn.+install' "$npm_log"; then
      echo "agent-coherence: cause: the prebuilt binary could not be DOWNLOADED (see the" >&2
      echo "agent-coherence: 'prebuild-install warn install' line above — e.g. ECONNRESET). The" >&2
      echo "agent-coherence: node-gyp trace after it is the fallback failing, not the cause, and" >&2
      echo "agent-coherence: your Node major is fine. This is transient: RETRY." >&2
    else
      echo "agent-coherence: (no recognised cause in the npm output above. The usual three are a" >&2
      echo "agent-coherence: missing prebuilt for this platform, a failed prebuilt download, and" >&2
      echo "agent-coherence: an ESTRICTALLOWSCRIPTS block on the install script.)" >&2
    fi
    rm -f "$npm_log"
    exit 1
  fi
  rm -f "$npm_log"
  # Install-time verification. npm exiting 0 does NOT prove the native addon
  # arrived: better-sqlite3's install script IS the prebuilt download, so an
  # `ignore-scripts=true` in any npmrc suppresses it silently and yields a
  # tree that installs "successfully" and then crash-loops at first Database
  # open. Prove the addon loads before stamping this ABI as good.
  if ! native_module_loads; then
    rm -f "${CLAUDE_PLUGIN_DATA}/package.json"
    echo "agent-coherence: npm install reported success but the better-sqlite3 native addon does not load; coordinator will not start this session. Next session retries." >&2
    echo "agent-coherence: (most likely 'ignore-scripts' is set in an npmrc — better-sqlite3's install" >&2
    echo "agent-coherence: script is the prebuilt download, so suppressing it leaves no binary behind.)" >&2
    exit 1
  fi
  printf '%s\n' "$NODE_ABI" >"$ABI_STAMP"
fi

# Stage 2: provision dist/ into PLUGIN_DATA so coordinator.js sits in the
# same directory tree as node_modules (ESM resolution requirement). Two
# sources, first match wins:
#   (i)  The package ships a built dist/ (dev checkout after `npm run
#        build`): mirror it. rsync only copies changed files; the cp -r
#        fallback covers systems without rsync.
#   (ii) No dist/ — the normal marketplace shape: build src/ with tsc,
#        keyed on a package change or a stale built entry. tsc is a
#        devDependency, so it lives in PLUGIN_DATA's install and usually in
#        the plugin cache's own node_modules too.
#
# "Stale" is the Stage-1 ABI lesson applied to this key: package.json is
# only a PROXY for "the package changed", so a plugin update that touches
# src/ without bumping the version would otherwise keep the old dist/
# forever. A git update rewrites mtimes, so newer-than-the-built-entry is
# the signal that actually tracks the sources. A missing entry also counts,
# which is what makes a FAILED build retry next session.
#
# An ABI change deliberately does NOT key this rebuild: dist/ is tsc output,
# plain JavaScript, with no binding to process.versions.modules.
dist_stale=0
if [ ! -f "${CLAUDE_PLUGIN_DATA}/dist/coordinator.js" ]; then
  dist_stale=1
elif [ -n "$(find "${CLAUDE_PLUGIN_ROOT}/src" "${CLAUDE_PLUGIN_ROOT}/tsconfig.json" \
  -newer "${CLAUDE_PLUGIN_DATA}/dist/coordinator.js" -print -quit 2>/dev/null)" ]; then
  dist_stale=1
fi
if [ -f "${CLAUDE_PLUGIN_ROOT}/dist/coordinator.js" ]; then
  mkdir -p "${CLAUDE_PLUGIN_DATA}/dist"
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete "${CLAUDE_PLUGIN_ROOT}/dist/" "${CLAUDE_PLUGIN_DATA}/dist/"
  else
    cp -r "${CLAUDE_PLUGIN_ROOT}/dist/." "${CLAUDE_PLUGIN_DATA}/dist/"
  fi
elif [ "$deps_changed" = "1" ] || [ "$dist_stale" = "1" ]; then
  tsc_bin=""
  for cand in "${CLAUDE_PLUGIN_DATA}/node_modules/.bin/tsc" "${CLAUDE_PLUGIN_ROOT}/node_modules/.bin/tsc"; do
    if [ -x "$cand" ]; then
      tsc_bin="$cand"
      break
    fi
  done
  if [ -z "$tsc_bin" ]; then
    echo "agent-coherence: plugin package has no dist/ and no tsc to build src/ (checked ${CLAUDE_PLUGIN_DATA}/node_modules/.bin and ${CLAUDE_PLUGIN_ROOT}/node_modules/.bin); coordinator will not start this session. Next session retries." >&2
    exit 1
  fi
  echo "agent-coherence: plugin package has no dist/ (marketplace clone); building src/ into ${CLAUDE_PLUGIN_DATA}/dist" >&2
  # Stage src + tsconfig next to node_modules and clean-build so no stale
  # compiled files from a previous version survive a layout change.
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete "${CLAUDE_PLUGIN_ROOT}/src/" "${CLAUDE_PLUGIN_DATA}/src/"
  else
    rm -rf "${CLAUDE_PLUGIN_DATA}/src"
    mkdir -p "${CLAUDE_PLUGIN_DATA}/src"
    cp -r "${CLAUDE_PLUGIN_ROOT}/src/." "${CLAUDE_PLUGIN_DATA}/src/"
  fi
  cp "${CLAUDE_PLUGIN_ROOT}/tsconfig.json" "${CLAUDE_PLUGIN_DATA}/" || exit 1
  rm -rf "${CLAUDE_PLUGIN_DATA}/dist"
  if ! (cd "${CLAUDE_PLUGIN_DATA}" && "$tsc_bin" -p tsconfig.json) >&2; then
    echo "agent-coherence: tsc build failed; coordinator will not start this session. Next session retries." >&2
    exit 1
  fi
fi

# Provision verification — never spawn (or report success for) a missing
# entry point. Before this check, a dist-less package produced an infinite
# MODULE_NOT_FOUND crash loop behind a false "spawned" message.
if [ ! -f "${CLAUDE_PLUGIN_DATA}/dist/coordinator.js" ]; then
  echo "agent-coherence: ${CLAUDE_PLUGIN_DATA}/dist/coordinator.js missing after provisioning; coordinator will not start this session. Next session retries." >&2
  python_backend_hint >&2
  exit 1
fi

# Stage 3: simple "is coordinator running" check (WORKSPACE/PIDFILE resolved
# up top, before the virgin-store marker). Unit 5 replaces this best-effort
# check with a proper fcntl flock per KTD-A.5 point 1.
if [ -f "$PIDFILE" ]; then
  EXISTING_PID=$(head -1 "$PIDFILE" 2>/dev/null || echo "")
  if [ -n "$EXISTING_PID" ] && kill -0 "$EXISTING_PID" 2>/dev/null; then
    echo "agent-coherence: coordinator already running (pid=$EXISTING_PID)" >&2
    exit 0
  fi
  echo "agent-coherence: stale pid file (pid='${EXISTING_PID}' not running); spawning fresh" >&2
fi

# Stage 4: spawn the coordinator. Detach from the SessionStart hook's
# process group so the hook can exit cleanly while the coordinator keeps
# running for subsequent PreToolUse / Stop hook calls.
COORD_LOG="${CLAUDE_PLUGIN_DATA}/coordinator.log"
nohup node "${CLAUDE_PLUGIN_DATA}/dist/coordinator.js" >>"$COORD_LOG" 2>&1 &
SPAWNED_PID=$!
disown 2>/dev/null || true

# Startup liveness gate: an entry/dependency problem kills the child within
# milliseconds (the pre-fix failure mode logged hundreds of MODULE_NOT_FOUND
# crashes behind a false success line). Half a second catches that class; a
# healthy coordinator keeps running. Only the spawn path pays this — the
# common already-running session exits above.
sleep 0.5
if ! kill -0 "$SPAWNED_PID" 2>/dev/null; then
  echo "agent-coherence: Node coordinator exited immediately after spawn; recent ${COORD_LOG}:" >&2
  tail -n 12 "$COORD_LOG" >&2 2>/dev/null || true
  # A NODE_MODULE_VERSION death means node_modules is ABI-stale despite a
  # stamp that vouched for it — a hand-restored tree, a partial install, a
  # stamp written before this session's node changed underneath it. Drop the
  # stamp so the next session probes and reinstalls instead of crash-looping
  # forever. Scoped to that one error, and self-limiting: an unstamped tree
  # that actually loads is only backfilled, never reinstalled, so an
  # unrelated coordinator crash cannot turn into a reinstall every session.
  if tail -n 40 "$COORD_LOG" 2>/dev/null | grep -q 'NODE_MODULE_VERSION'; then
    rm -f "$ABI_STAMP"
    echo "agent-coherence: (native-ABI mismatch detected; next session reprovisions node_modules.)" >&2
  fi
  exit 1
fi

# First-provision backend stamp: this bootstrap just initialized a VIRGIN
# workspace (no state.db before boot) and proved the coordinator lives, so
# the store is Node-owned from birth. Record that as the explicit backend
# selection. Without the stamp, the dispatcher's guard (a) (state.db present
# → python default) would misread the Node-born store as an established
# Python workspace on the NEXT session and route to the Python bootstrap —
# one working session, then silent degrade after reboot on exactly the
# zero-Python machines the Node default exists for. An operator's existing
# selection file is never overwritten.
if [ "$workspace_had_state_db" = "0" ] && [ ! -f "${WORKSPACE}/.coherence/coordinator_backend" ]; then
  mkdir -p "${WORKSPACE}/.coherence"
  echo "node" >"${WORKSPACE}/.coherence/coordinator_backend"
fi

echo "agent-coherence: spawned Node coordinator (pid=${SPAWNED_PID}, log=${COORD_LOG})" >&2
