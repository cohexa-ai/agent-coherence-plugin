#!/usr/bin/env bash
# agent-coherence Node coordinator: SessionStart bootstrap + lazy launch.
#
# Implements the officially-documented Claude Code plugin pattern for native
# Node dependencies per `code.claude.com/docs/en/plugins-reference` § ${CLAUDE_PLUGIN_DATA}:
# install deps lazily into PLUGIN_DATA on first use; persist across plugin
# updates; retry on next session if install fails.
#
# Why this script puts package.json, node_modules AND dist/ together in one
# build under PLUGIN_DATA (vs the documented snippet which only copies
# package.json + relies on NODE_PATH): the coordinator uses ESM (`"type":
# "module"` in package.json), and Node's ESM resolver does NOT honor NODE_PATH
# — it walks the import tree from the importing file's directory. Putting
# dist/ beside node_modules puts coordinator.js in the same tree, so `import
# "better-sqlite3"` resolves cleanly. Each build is its own directory,
# published once whole (#295; see "Published builds" below).
#
# Where dist/ comes from: a marketplace install is a git clone, and dist/ is
# gitignored — so NO released package contains compiled output (the release
# workflow's dist.tar.gz is a GitHub-Release asset the marketplace flow never
# consumes). When ${CLAUDE_PLUGIN_ROOT}/dist is absent, Stage 2 therefore
# BUILDS src/ into the build's dist/ at provision time, with the tsc that Stage
# 1's dev-inclusive `npm install` (or the installer's own npm install in the
# plugin cache) provides. Before this landed, Stage 4 spawned a nonexistent
# entry point and reported success while the coordinator crash-looped
# MODULE_NOT_FOUND into coordinator.log — a silent no-op of every hook
# surface on exactly the fresh installs the Node default exists to serve.
#
# Selected by bin/ensure-coordinator-dispatch at SessionStart when the
# backend resolves to `node` (env > .coherence/coordinator_backend file >
# guarded default; see that script's header). On the Python backend the
# dispatcher runs it with AGENT_COHERENCE_PROVISION_ONLY=1, which stops after
# Stage 2 (see below).

set -uo pipefail

# CLAUDE_PLUGIN_ROOT and CLAUDE_PLUGIN_DATA are provided by Claude Code per
# the plugin spec. Bail loudly if invoked outside that context — useful for
# local development to catch missing-env mistakes early.
: "${CLAUDE_PLUGIN_ROOT:?CLAUDE_PLUGIN_ROOT must be set by Claude Code; invoke via a SessionStart hook}"
: "${CLAUDE_PLUGIN_DATA:?CLAUDE_PLUGIN_DATA must be set by Claude Code; invoke via a SessionStart hook}"

mkdir -p "${CLAUDE_PLUGIN_DATA}"

# >>> coherence-dir-check: keep byte-identical in ensure-coordinator-dispatch
# and ensure-coordinator-node (pinned by a test). cohexa-ai/agent-coherence#498.
#
# .coherence must be absent or a real directory (one mounted there counts),
# and nothing directly inside it may be a symlink, a FIFO, a socket or a
# device. A repository can commit any of them and no coordinator creates one;
# a start would read and write through the link, or block on the FIFO. Checked
# before this script reads or writes anything under .coherence, with [ -L ],
# the type tests and globs only: it opens nothing there, so nothing it finds
# can hold the session start. [ -L ] comes first because the other tests
# follow a link, and a dangling one looks absent to them. A directory it
# cannot list passes, and the coordinator decides, as before.
#
# Prints the refused path and returns 1 for a link, 2 for a non-directory and
# 4 for a FIFO, socket or device; 0 when .coherence is absent or clean.
coherence_dir_problem() {
  local dir="$1" entry
  if [ -L "$dir" ]; then printf '%s\n' "$dir"; return 1; fi
  [ -e "$dir" ] || return 0
  if [ ! -d "$dir" ]; then printf '%s\n' "$dir"; return 2; fi
  { [ -r "$dir" ] && [ -x "$dir" ]; } || return 0
  for entry in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    if [ -L "$entry" ]; then printf '%s\n' "$entry"; return 1; fi
  done
  for entry in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    if [ -p "$entry" ] || [ -S "$entry" ] || [ -b "$entry" ] || [ -c "$entry" ]; then printf '%s\n' "$entry"; return 4; fi
  done
  return 0
}
# Refuses the start when $1/.coherence breaks the rule: one line on stderr, and
# one SessionStart JSON object on stdout, so the user (systemMessage) and the
# model (additionalContext) both learn that this start started no coordinator.
# The model is told only that: a coordinator already running for the workspace
# still answers the hooks. The caller then exits 0, with nothing else on
# stdout: Claude Code reads a hook's stdout as JSON only on exit 0, and shows a
# failing hook's stderr to the user alone.
refuse_coherence_dir() {   # 0 = refused (JSON printed), 1 = go on
  local found status name why fix
  found="$(coherence_dir_problem "$1/.coherence")"; status=$?
  [ "$status" = 0 ] && return 1
  # The name comes from the repository: keep JSON- and terminal-safe bytes only.
  name="$(printf '%s' "${found#"$1/"}" | LC_ALL=C tr -c 'A-Za-z0-9._/-' '?')"
  case "$status" in
    # A linked .coherence names a directory, not a file; a copy of state.db
    # alone loses the latest history its -wal and -shm hold.
    1) why="$name is a symlink"
       case "$name" in
         .coherence) fix="Replace the link with a real directory and copy in the files you want to keep (move state.db together with its -wal and -shm), or mount a directory at .coherence, then start a new session." ;;
         .coherence/state.db* | .coherence/workspace.db*) fix="Replace it with a copy of the file it names (move state.db together with its -wal and -shm), or mount a directory at .coherence, then start a new session." ;;
         *) fix="Replace it with a copy of the file it names, or mount a directory at .coherence, then start a new session." ;;
       esac ;;
    2) why="$name is not a directory"; fix="Move it aside, then start a new session." ;;
    *) why="$name is a FIFO, socket or device"; fix="Remove it, then start a new session." ;;
  esac
  echo "agent-coherence: not starting the coordinator: $why. $fix" >&2
  printf '{"systemMessage":"agent-coherence started no coordinator for this session: %s. %s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"agent-coherence did not start a coordinator at this session start, because %s. Hooks may still answer from a coordinator already running for this workspace: treat any warning or deny they give as real, and do not assume edits are coordinated otherwise. Tell the user."}}\n' "$why" "$fix" "$why"
  return 0
}
# <<< coherence-dir-check

# Workspace resolution (per-workspace state per KTD-C) + a virgin-store
# marker for the post-spawn backend stamp. The marker MUST be read before
# Stage 4 — the coordinator's own first boot creates state.db within
# milliseconds, which would make every workspace look established. Read
# before Stage 0 too, which keys its Python-backend hint on it.
WORKSPACE="${AGENT_COHERENCE_WORKSPACE:-$PWD}"
# Before anything below reads or writes under it. Nothing is on stdout yet, so
# on a refusal the JSON is the whole of it.
if refuse_coherence_dir "$WORKSPACE"; then
  exit 0
fi
PIDFILE="${WORKSPACE}/.coherence/server.pid"
workspace_had_state_db=0
if [ -f "${WORKSPACE}/.coherence/state.db" ]; then
  workspace_had_state_db=1
fi

# The Python backend is a fallback only while the workspace has no store: the
# Python coordinator creates its own, but fails closed on a state.db the Node
# coordinator created, and no tool converts a store between backends. With a
# store present this script runs only on an explicit `node` choice, so the
# store is most likely the Node coordinator's — the hint must not prescribe
# the switch there, or following it leaves the workspace with no coordinator.
python_backend_hint() {
  if [ "$workspace_had_state_db" = "0" ]; then
    echo "agent-coherence: alternatively, select the Python backend: mkdir -p '${WORKSPACE}/.coherence' && echo python > '${WORKSPACE}/.coherence/coordinator_backend'"
  else
    echo "agent-coherence: ${WORKSPACE}/.coherence/state.db exists, so select the Python backend only if the Python coordinator created it: it refuses a store the Node coordinator created, and no tool converts one."
  fi
}

# Stage 0: Node-ABI preflight. The zero-Python guarantee (decision B) holds
# only where better-sqlite3 ships a prebuilt binary for this Node ABI; on any
# other major, Stage 1's `npm install` falls back to node-gyp — which needs
# Python and a C++ toolchain, the exact dependencies this backend exists to
# avoid. better-sqlite3 12.10.0 dropped the Node 20 (ABI 115) and Node 23
# (ABI 131) prebuilts, so the supported majors are 22 / 24 / 25 (ABIs
# 127 / 137 / 141). KEEP IN SYNC with engines.node in package.json and the
# dispatcher's node_abi_supported() — package.json stays the enforced source
# of truth via --engine-strict on the install below.
NODE_VERSION_RAW="$(node --version 2>/dev/null || echo unknown)"
NODE_MAJOR="$(printf '%s' "$NODE_VERSION_RAW" | sed -n 's/^v\{0,1\}\([0-9][0-9]*\)\..*$/\1/p')"
case "$NODE_MAJOR" in
  22 | 24 | 25) ;;
  *)
    {
      echo "agent-coherence: Node ${NODE_VERSION_RAW} is not supported by the Node coordinator."
      echo "agent-coherence: better-sqlite3 ships prebuilt binaries only for Node 22, 24, and 25;"
      echo "agent-coherence: other majors fall back to node-gyp (Python + C++ toolchain), which the"
      echo "agent-coherence: zero-Python install guarantee forbids. Install Node 22 or 24 (LTS)."
      python_backend_hint
    } >&2
    exit 1
    ;;
esac

# The running Node's ABI (`process.versions.modules`) is what a compiled
# better_sqlite3.node is actually bound to — 131 for Node 23, 137 for Node
# 24 — and a binary built for one is a hard load error under the other. It
# is the provisioning key package.json cannot express; see Stage 1.
#
# The same node call fingerprints the package (#295): a SHA-256 over
# package.json, package-lock.json and what a build is made from, src/ and
# tsconfig.json, or a dev checkout's own dist/. BUILD_KEY, which adds the
# ABI, platform and arch a native addon is bound to, names the build this
# start needs; DEPS_DIGEST, over the two manifests alone, says whether npm
# has anything to do.
build_from=src
if [ -f "${CLAUDE_PLUGIN_ROOT}/dist/coordinator.js" ]; then
  build_from=dist
fi
FINGERPRINT_JS='
const { createHash } = require("node:crypto");
const { readFileSync, readdirSync } = require("node:fs");
const [root, from] = process.argv.slice(1);
const digest = (paths) => {
  const hash = createHash("sha256").update("agent-coherence build 1\0" + from + "\0");
  const add = (rel) => {
    let bytes;
    try { bytes = readFileSync(root + "/" + rel); } catch { bytes = Buffer.from("\0missing"); }
    hash.update(rel + "\0" + bytes.length + "\0").update(bytes);
  };
  const walk = (rel) => {
    let entries;
    try { entries = readdirSync(root + "/" + rel, { withFileTypes: true }); } catch { add(rel); return; }
    entries
      .sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))
      .forEach((entry) => (entry.isDirectory() ? walk(rel + "/" + entry.name) : add(rel + "/" + entry.name)));
  };
  paths.forEach(walk);
  return hash.digest("hex").slice(0, 16);
};
const manifests = ["package.json", "package-lock.json"];
const sources = from === "dist" ? ["dist"] : ["tsconfig.json", "src"];
const abi = process.versions.modules;
console.log(abi, abi + "-" + process.platform + "-" + process.arch, digest([...manifests, ...sources]), digest(manifests));
'
read -r NODE_ABI ABI_TAG SRC_DIGEST DEPS_DIGEST <<<"$(node -e "$FINGERPRINT_JS" "$CLAUDE_PLUGIN_ROOT" "$build_from" 2>/dev/null)"
NODE_ABI="${NODE_ABI:-unknown}"
if [ -z "${DEPS_DIGEST:-}" ]; then
  echo "agent-coherence: could not fingerprint ${CLAUDE_PLUGIN_ROOT}; coordinator will not start this session. Next session retries." >&2
  exit 1
fi
BUILD_KEY="${ABI_TAG}-${SRC_DIGEST}"

# Published builds (#295). Every workspace's hooks, CLI shims and Node
# coordinators load from this one CLAUDE_PLUGIN_DATA, and Claude Code runs a
# session's SessionStart hooks at once, so a provision always races readers
# starting up, and other session starts, on any workspace and either backend.
# Writing the tree they load in place tore it under them: a reinstall after a
# Node-major change deleted node_modules for its whole run, an upgrade's npm
# install unpacked each changed package straight into the live path, and two
# starts at once built into one dist.next and could nest one build inside
# the other or delete it.
#
# So nothing a reader loads is ever written in place. Each provision builds
# into a directory of its own, builds/<BUILD_KEY>.<random>, sealed by .ok,
# written last, and never written again; it is published by replacing the
# one-line file `current` with rename(2), which no reader sees half done.
# The shims read that line and run the build it names, and Stage 4 spawns
# the build this start verified. A lock on .provision.lock serializes the
# provisioners, but no build depends on it: a host that cannot lock only
# builds twice.
#
# The layout older plugin versions use, DATA/{dist,node_modules,package.json,
# package-lock.json,src,tsconfig.json,.node-abi}, is theirs alone. This script
# never writes it, so their provisioning cannot reach a build this one
# published, and sessions of those versions keep running the build their own
# version made.
BUILDS="${CLAUDE_PLUGIN_DATA}/builds"
POINTER="${CLAUDE_PLUGIN_DATA}/current"
# Never unlinked: the lock lives on its inode.
PROVISION_LOCK="${CLAUDE_PLUGIN_DATA}/.provision.lock"
PROVISION_WAIT_S="${AGENT_COHERENCE_PROVISION_WAIT_S:-120}"
case "$PROVISION_WAIT_S" in '' | *[!0-9]*) PROVISION_WAIT_S=120 ;; esac
# Decimal, also when zero-padded: $(( )) reads 08 as a malformed octal number.
PROVISION_WAIT_S=$((10#$PROVISION_WAIT_S))
# Longer than Claude Code's 600 s hook time box, so no hook is still loading a
# build when it is removed.
BUILD_GRACE_MIN=15
# An unfinished build this old is no start's work in progress: a start that
# could not lock may still be writing a younger one.
UNFINISHED_BUILD_MIN=60
STALE_POINTER_TMP_MIN=5

# One LOCK_EX|LOCK_NB attempt on the open file behind fd 9, by a helper that
# inherits fd 9 and exits. A flock belongs to the open file, not to the
# process that asked for it, so the lock stays with this shell's fd 9 until it
# is closed, and goes when this shell dies, however it dies (the helpers in
# src/coordinator_lock.ts lock server.pid the same way). Every child that can
# outlive a moment runs with 9>&-, so none keeps the lock once this shell is
# gone: on the child itself or a ( subshell ), never on a { group } or a
# function call, which bash 3.2 runs with the lock still open on a saved copy
# of fd 9. Returns 0 taken, 1 held by another start, 3 cannot lock here.
provision_lock_try() {
  local status
  # perl first: it alone tells a held lock (1) from a file system that cannot
  # lock (3).
  if command -v perl >/dev/null 2>&1; then
    perl -MFcntl=:flock -e 'open(my $fh, "+<&=", 9) or exit 2; exit 0 if flock($fh, LOCK_EX | LOCK_NB); exit($!{EWOULDBLOCK} ? 1 : 3)' 2>/dev/null
    status=$?
    case "$status" in 0 | 1 | 3) return "$status" ;; esac
  fi
  if command -v flock >/dev/null 2>&1; then
    flock -x -n 9 2>/dev/null
    status=$?
    # BusyBox flock(1) exits 1 for a held lock and for one the file system
    # cannot take alike: a lock on a file of this start's own tells them apart.
    if [ "$status" = 1 ] && ! provision_fs_can_lock; then
      return 3
    fi
    case "$status" in 0 | 1) return "$status" ;; esac
  fi
  case "${OSTYPE:-}" in
    darwin*)
      lockf -s -t 0 9 2>/dev/null
      status=$?
      case "$status" in 0) return 0 ;; 75) return 1 ;; esac
      ;;
  esac
  return 3
}
provision_fs_can_lock() {
  local probe="${CLAUDE_PLUGIN_DATA}/.provision.lock.probe.$$" status
  : >"$probe" 2>/dev/null || return 1
  flock -x -n "$probe" true 2>/dev/null
  status=$?
  rm -f "$probe"
  [ "$status" = 0 ]
}
# Take the lock, waiting at most PROVISION_WAIT_S. While it waits it reads
# `current`, and stops waiting once that names a finished build for this key:
# the start holding the lock built what this one needs. Returns 0 locked,
# 1 gave up, 2 the build this start needs is published, 3 nothing here can
# lock (provision unlocked: at worst a build is made twice).
acquire_provision_lock() {
  local deadline=$((SECONDS + PROVISION_WAIT_S)) said=0 status
  { exec 9<>"$PROVISION_LOCK"; } 2>/dev/null || return 3
  while :; do
    provision_lock_try
    status=$?
    [ "$status" = 0 ] && return 0
    if [ "$status" != 1 ]; then
      exec 9>&-
      return 3
    fi
    read_pointer
    if published_is_wanted; then
      exec 9>&-
      return 2
    fi
    if [ "$said" = 0 ]; then
      echo "agent-coherence: another session start is provisioning ${CLAUDE_PLUGIN_DATA}; waiting up to ${PROVISION_WAIT_S}s" >&2
      said=1
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      exec 9>&-
      return 1
    fi
    sleep 0.25 9>&- 2>/dev/null || sleep 1 9>&-
  done
}
# LOCK_UN as well as the close, so a straggler that inherited fd 9 cannot
# keep the lock.
release_provision_lock() {
  perl -MFcntl=:flock -e 'open(my $fh, "+<&=", 9) and flock($fh, LOCK_UN)' 2>/dev/null || flock -u 9 2>/dev/null || true
  exec 9>&-
}

# The build `current` names, in $published: empty when there is none, or when
# the line is not a plain name inside builds/.
read_pointer() {
  published=""
  if [ -f "$POINTER" ]; then
    IFS= read -r published <"$POINTER" || true
  fi
  case "$published" in "" | */* | .*) published="" ;; esac
}
# Finished: .ok, written last, is there, and so is what it vouched for.
build_complete() {
  [ -n "$1" ] && [ -f "$BUILDS/$1/.ok" ] && [ -d "$BUILDS/$1/node_modules" ] && [ -f "$BUILDS/$1/dist/coordinator.js" ]
}
published_is_wanted() {
  case "$published" in "$BUILD_KEY".*) build_complete "$published" ;; *) return 1 ;; esac
}
# Prints the name of a finished build matching glob $1, the published one first.
find_build() {
  local dir
  case "$published" in $1) build_complete "$published" && { printf '%s' "$published"; return 0; } ;; esac
  for dir in "$BUILDS"/$1; do
    build_complete "${dir##*/}" && { printf '%s' "${dir##*/}"; return 0; }
  done
  return 1
}
# Copy directory $1 to the new path $2: a clone where the file system can make
# one (APFS through cp -c, GNU cp --reflink), else a plain copy.
copy_tree() {
  cp -cpR "$1" "$2" 9>&- 2>/dev/null ||
    { rm -rf "$2" 9>&-; cp -pR --reflink=auto "$1" "$2" 9>&- 2>/dev/null; } ||
    { rm -rf "$2" 9>&-; cp -pR "$1" "$2" 9>&-; }
}

# Is the install in directory $1 whole, and does its native addon load under
# THIS node? Exits 0 yes, 4 a package package.json declares is missing, other
# non-zero the addon does not load.
#
# Every declared package must be in $1's own node_modules: Node resolves a
# missing one from an ancestor directory, and DATA/node_modules above a build
# is an older version's install.
#
# Deliberately CONSTRUCTS a Database: better-sqlite3 resolves its addon
# through `bindings` at first use, not at require time, so a bare
# `require("better-sqlite3")` exits 0 even when the .node file is missing or
# ABI-stale — a probe keyed on require alone passes in exactly the broken
# states it exists to catch.
#
# Keyed on what the package.json DECLARES, not on what resolves: a package
# that never depended on better-sqlite3 (the provisioning tests' stub) needs
# no addon.
native_module_loads() {
  (
    cd "$1" 2>/dev/null || exit 1
    node -e '
      const { existsSync } = require("node:fs");
      const deps = require("./package.json").dependencies || {};
      for (const name of Object.keys(deps)) {
        if (!existsSync("node_modules/" + name + "/package.json")) process.exit(4);
      }
      if (!deps["better-sqlite3"]) process.exit(0);
      new (require("better-sqlite3"))(":memory:").close();
    '
  ) 9>&- >/dev/null 2>&1
}

install_deps() {
  local dir="$1"
  echo "agent-coherence: installing Node deps into ${dir}" >&2
  # --engine-strict turns the engines.node range into a hard install-time
  # gate (npm only warns by default), so the Stage-0 list above can never
  # silently drift past package.json.
  # Capture as well as show, so the failure below can be CLASSIFIED rather
  # than guessed at. PIPESTATUS[0] is npm's status; $? would be tee's.
  npm_log="$(mktemp "${TMPDIR:-/tmp}/agent-coherence-npm.XXXXXX" 2>/dev/null || echo "")"
  if [ -n "$npm_log" ]; then
    # --loglevel=http is what makes the failure below CLASSIFIABLE: npm passes
    # it down as npm_config_loglevel, and prebuild-install gates its own
    # `log.http(res.statusCode, url)` on exactly that (its log.js defaults to
    # 'notice', above which http is dropped). Without it the HTTP status of a
    # failed asset fetch is never printed by anyone and cannot be recovered
    # afterwards -- not even from npm's debug log, which can only capture what
    # the child chose to emit.
    #
    # The `grep -v` filters the DISPLAY, never the captured log. At http level
    # npm logs one `cache`/`fetch GET 200` line per package: measured 148
    # lines / 16KB warm and 298 / 31KB cold on this repo's own tree. This
    # script's stdout is a SessionStart hook's stdout, so that lands in the
    # model's context, where 31KB of registry chatter is several times the
    # 10,000-byte ceiling and would evict the very diagnostic it came for.
    # Filtered, the visible output matches an unflagged run except for npm's
    # own "added N packages in Xs" duration line, which differs between any
    # two runs regardless of this flag -- measured, not assumed.
    # prebuild-install's own lines survive because npm prefixes them
    # `npm error `, not `npm http `.
    #
    # tee BEFORE grep is deliberate, and is defensive rather than currently
    # load-bearing: no classifier input is filter-shaped today, so swapping
    # the two would change nothing observable. It matters the moment either
    # side moves -- a broader filter, or an npm that stops prefixing a
    # script's output -- at which point capturing first is what keeps the
    # classifier reading everything npm said while the operator reads less.
    # The two alternatives below are a snapshot of npm's http vocabulary;
    # a third shape would leak noise to the display, never hide a diagnostic.
    (cd "$dir" && npm install --engine-strict --no-audit --no-fund --no-progress --loglevel=http 2>&1) 9>&- \
      | tee "$npm_log" 9>&- | grep -v '^npm http \(cache\|fetch GET 200\)' 9>&-
    # Must stay on the line immediately after the pipeline: PIPESTATUS is
    # clobbered by the next command. Still index 0 through three stages.
    npm_status=${PIPESTATUS[0]}
  else
    (cd "$dir" && npm install --engine-strict --no-audit --no-fund --no-progress 2>&1) 9>&-
    npm_status=$?
  fi
  if [ "$npm_status" -ne 0 ]; then
    echo "agent-coherence: npm install failed; coordinator will not start this session. Next session retries." >&2
    # WHY CLASSIFY, and why the order below is load-bearing. Every failure
    # here ends in the same node-gyp "find Python" trace, because
    # better-sqlite3 falls back to compiling whenever it cannot place a
    # prebuilt binary -- for ANY reason. This block used to assert the first
    # explanation unconditionally, which sent the reader to check their Node
    # version even when the real cause was a dropped connection.
    #
    # ESTRICTALLOWSCRIPTS is tested FIRST because it is a terminal npm error
    # code rather than a warning: a log carrying it is that failure whatever
    # prebuild-install managed to log on the way, and with more than one
    # native dependency both can appear.
    if [ -z "$npm_log" ]; then
      # Say what happened, not what we guess. mktemp failed, so npm's output
      # was never captured and nothing was examined.
      echo "agent-coherence: (npm's output could not be captured — mktemp failed — so no" >&2
      echo "agent-coherence: cause was classified. The usual three are a missing prebuilt for" >&2
      echo "agent-coherence: this platform, a failed prebuilt download, and an" >&2
      echo "agent-coherence: ESTRICTALLOWSCRIPTS block on the install script.)" >&2
    elif grep -q 'ESTRICTALLOWSCRIPTS' "$npm_log"; then
      echo "agent-coherence: cause: npm 11 blocked an install script. The allowScripts entry in" >&2
      echo "agent-coherence: package.json covers better-sqlite3's prebuilt fetch, so a NEW package" >&2
      echo "agent-coherence: there needs adding to it." >&2
    elif grep -qiE 'prebuild-install.+warn.+install.+No prebuilt binaries found' "$npm_log"; then
      # "No prebuilt binaries found" does NOT mean the ABI is unsupported. It
      # is also what prebuild-install reports for any non-200 response:
      # download.js does `if (res.statusCode !== 200) return onerror()` with
      # no argument, and onerror falls through to `error.noPrebuilts(opts)`.
      # The message's own `target=` field is the discriminator, and Stage 0
      # has already refused to get here on an unsupported major -- so when
      # they agree, the major is fine and the prebuilt simply could not be
      # placed. The HTTP status separates a missing asset from a transient
      # 5xx, and the install above now asks for it (--loglevel=http). It is
      # absent only when the capture itself failed, and that case says so
      # instead of guessing.
      target_major="$(sed -n 's/.*No prebuilt binaries found (target=v\{0,1\}\([0-9][0-9]*\)\..*/\1/p' "$npm_log" | head -n 1)"
      # simple-get follows 3xx before the callback, so exactly one numeric
      # line is logged per download and it carries the FINAL status;
      # `http request GET …` has a non-numeric second token and cannot match.
      #
      # `tail -n 1` is unambiguous because better-sqlite3 is the ONLY
      # prebuild-install consumer in this tree (one install script:
      # `prebuild-install || node-gyp rebuild --release`). Add a second
      # prebuilt-using native dependency and that stops holding: a sibling's
      # `http 200` could be read as the status for better-sqlite3's own 404,
      # printing "the server said 200 ... transient: RETRY". If that day comes,
      # scope the match to the failing package rather than taking the last line.
      http_status="$(sed -n 's/.*prebuild-install http \([0-9][0-9][0-9]\) .*/\1/p' "$npm_log" | tail -n 1)"
      if [ -n "$target_major" ] && [ "$target_major" != "$NODE_MAJOR" ]; then
        echo "agent-coherence: cause: no better-sqlite3 prebuilt for Node ${target_major}." >&2
        echo "agent-coherence: supported majors are 22 / 24 / 25; running ${NODE_VERSION_RAW}." >&2
        echo "agent-coherence: retrying will not help — switch Node majors." >&2
      elif [ "$http_status" = "404" ]; then
        # Deliberately not called permanent: a release can 404 mid-publish, an
        # unsynced binary-host mirror 404s, and blocking proxies 404 the hosts
        # they disallow.
        echo "agent-coherence: cause: no prebuilt is published for this platform (asset 404)." >&2
        echo "agent-coherence: Node ${NODE_VERSION_RAW} is supported, so this is NOT your Node version —" >&2
        echo "agent-coherence: it is this platform/arch/libc. A retry is unlikely to help. Two things" >&2
        echo "agent-coherence: also produce a 404 here: a binary-host mirror that has not synced, and a" >&2
        echo "agent-coherence: proxy or firewall that 404s the release host rather than refusing it." >&2
      elif [ "$http_status" = "429" ] || case "$http_status" in 5??) true ;; *) false ;; esac; then
        echo "agent-coherence: cause: the prebuilt download failed — the server said ${http_status}." >&2
        echo "agent-coherence: Node ${NODE_VERSION_RAW} is supported and the asset exists; the node-gyp" >&2
        echo "agent-coherence: trace after it is the fallback failing, not the cause." >&2
        echo "agent-coherence: This is transient: RETRY." >&2
      elif [ -n "$http_status" ]; then
        # Everything else -- 401, 403, 451 -- is a refusal, not a wobble.
        # Saying "transient: RETRY" here sends an operator behind a blocking
        # proxy round a loop that can never succeed.
        echo "agent-coherence: cause: the prebuilt download was refused — the server said ${http_status}." >&2
        echo "agent-coherence: Node ${NODE_VERSION_RAW} is supported and this is not a wobble: a proxy," >&2
        echo "agent-coherence: firewall or auth token blocking the release host produces this." >&2
        echo "agent-coherence: Retrying unchanged will not help." >&2
      else
        echo "agent-coherence: cause: a better-sqlite3 prebuilt could not be placed for this platform." >&2
        echo "agent-coherence: Node ${NODE_VERSION_RAW} is supported, so this is NOT your Node version." >&2
        echo "agent-coherence: No HTTP status was captured, so a missing asset and a transient failure" >&2
        echo "agent-coherence: cannot be told apart here — try ONE retry before concluding either." >&2
      fi
    elif grep -qiE 'prebuild-install.+warn.+install' "$npm_log"; then
      echo "agent-coherence: cause: the prebuilt binary could not be DOWNLOADED (see the" >&2
      echo "agent-coherence: 'prebuild-install warn install' line above — e.g. ECONNRESET). The" >&2
      echo "agent-coherence: node-gyp trace after it is the fallback failing, not the cause, and" >&2
      echo "agent-coherence: your Node major is fine. This is transient: RETRY." >&2
    else
      echo "agent-coherence: (no recognised cause in the npm output above. The usual three are a" >&2
      echo "agent-coherence: missing prebuilt for this platform, a failed prebuilt download, and" >&2
      echo "agent-coherence: an ESTRICTALLOWSCRIPTS block on the install script.)" >&2
    fi
    rm -f "$npm_log"
    exit 1
  fi
  rm -f "$npm_log"
  # Install-time verification. npm exiting 0 does NOT prove the native addon
  # arrived: better-sqlite3's install script IS the prebuilt download, so an
  # `ignore-scripts=true` in any npmrc suppresses it silently and yields a
  # tree that installs "successfully" and then crash-loops at first Database
  # open. Prove the addon loads before the build is sealed.
  native_module_loads "$dir"
  native_status=$?
  if [ "$native_status" = 4 ]; then
    echo "agent-coherence: npm install reported success but node_modules lacks a package package.json declares; coordinator will not start this session. Next session retries." >&2
    exit 1
  fi
  if [ "$native_status" != 0 ]; then
    echo "agent-coherence: npm install reported success but the better-sqlite3 native addon does not load; coordinator will not start this session. Next session retries." >&2
    echo "agent-coherence: (most likely 'ignore-scripts' is set in an npmrc — better-sqlite3's install" >&2
    echo "agent-coherence: script is the prebuilt download, so suppressing it leaves no binary behind.)" >&2
    exit 1
  fi
}

# Stage 2 into build directory $1: build src/ with tsc, which is a
# devDependency, so it lives in the build's own install and usually in the
# plugin cache's node_modules too.
compile_dist() {
  local dir="$1" tsc_bin="" cand
  for cand in "$dir/node_modules/.bin/tsc" "${CLAUDE_PLUGIN_ROOT}/node_modules/.bin/tsc"; do
    if [ -x "$cand" ]; then
      tsc_bin="$cand"
      break
    fi
  done
  if [ -z "$tsc_bin" ]; then
    echo "agent-coherence: plugin package has no dist/ and no tsc to build src/ (checked ${dir}/node_modules/.bin and ${CLAUDE_PLUGIN_ROOT}/node_modules/.bin); coordinator will not start this session. Next session retries." >&2
    exit 1
  fi
  echo "agent-coherence: plugin package has no dist/ (marketplace clone); building src/ into ${dir}/dist" >&2
  if ! { copy_tree "${CLAUDE_PLUGIN_ROOT}/src" "$dir/src" && cp "${CLAUDE_PLUGIN_ROOT}/tsconfig.json" "$dir/"; }; then
    echo "agent-coherence: could not copy src/ and tsconfig.json from ${CLAUDE_PLUGIN_ROOT}; coordinator will not start this session. Next session retries." >&2
    exit 1
  fi
  if ! (cd "$dir" && "$tsc_bin" -p tsconfig.json --outDir "$dir/dist") 9>&- >&2; then
    echo "agent-coherence: tsc build failed; the previous build stays in place, and the coordinator will not start this session. Next session retries." >&2
    exit 1
  fi
}

# Stage 1 into build directory $1.
stage_node_modules() {
  local dir="$1" seed seed_deps=""
  # Started from a finished build's node_modules for this same ABI,
  # the install is the incremental one an in-place install was, into a tree
  # no reader loads. Never started from another ABI's: a compiled
  # better_sqlite3.node is bound to process.versions.modules, and npm leaves a
  # package it finds at a satisfying version alone, so only a clean install
  # makes prebuild-install fetch the prebuilt for this ABI. `npm rebuild` is
  # deliberately not used: it compiles from source via node-gyp, which needs
  # Python and a C++ toolchain, the exact dependencies decision B's zero-Python
  # guarantee forbids. And never started from DATA/node_modules: an older
  # plugin version may be rewriting it.
  seed="$(find_build "$ABI_TAG-*")" || seed=""
  if [ -n "$seed" ]; then
    copy_tree "$BUILDS/$seed/node_modules" "$dir/node_modules" || exit 1
    read -r _ seed_deps <"$BUILDS/$seed/.ok" || true
  elif [ -n "$published" ] && [ "${published%%-*}" != "$NODE_ABI" ]; then
    echo "agent-coherence: Node ABI changed (${published%%-*} -> ${NODE_ABI}); reinstalling native deps" >&2
  fi
  if [ "$seed_deps" = "$DEPS_DIGEST" ]; then
    if ! native_module_loads "$dir"; then
      # A seed whose addon does not load: install over it would leave the
      # stale binary in place, so start this one clean.
      echo "agent-coherence: provisioned native addon does not load under Node ${NODE_VERSION_RAW} (ABI ${NODE_ABI}); reinstalling" >&2
      rm -rf "$dir/node_modules" 9>&-
      install_deps "$dir"
    fi
  else
    install_deps "$dir"
  fi
  # A package with no dependencies gets no node_modules from npm.
  mkdir -p "$dir/node_modules" || exit 1
}

# Stage 2 into build directory $1.
stage_dist() {
  local dir="$1" same_src
  # dist/ beside node_modules in the same build, so coordinator.js
  # sits in the same directory tree as node_modules (ESM resolution
  # requirement). A dev checkout ships its own dist/; a build of the same
  # sources for another ABI already holds this dist/ (tsc output is plain
  # JavaScript, bound to no ABI); else src/ is built.
  if [ "$build_from" = dist ]; then
    copy_tree "${CLAUDE_PLUGIN_ROOT}/dist" "$dir/dist" || exit 1
  elif same_src="$(find_build "*-${SRC_DIGEST}.*")"; then
    copy_tree "$BUILDS/$same_src/dist" "$dir/dist" || exit 1
  else
    compile_dist "$dir"
  fi
}

# Make the build for BUILD_KEY in a new directory nothing else writes, seal
# it, and set BUILD. Any failure exits 1, and the EXIT trap removes the
# unfinished directory, so a failed or interrupted provision changes nothing a
# reader loads (one killed outright is left for collect_builds).
build_new() {
  local dir
  if ! { mkdir -p "$BUILDS" && dir="$(mktemp -d "$BUILDS/$BUILD_KEY.XXXXXX")"; } 2>/dev/null; then
    echo "agent-coherence: could not create a build directory under ${BUILDS}; coordinator will not start this session. Next session retries." >&2
    exit 1
  fi
  NEW_BUILD_DIR="$dir"
  # A cold `npm install` regularly outruns the SessionStart hook's time box,
  # and without the trap every timed-out provision leaves a full npm log
  # behind in TMPDIR, and its unfinished build in builds/ until it is collected.
  trap 'rm -f "${npm_log:-}"; [ -z "${NEW_BUILD_DIR:-}" ] || rm -rf "$NEW_BUILD_DIR"' EXIT
  # package.json first: it makes the build directory npm's project root.
  cp "${CLAUDE_PLUGIN_ROOT}/package.json" "$dir/" || exit 1
  if [ -f "${CLAUDE_PLUGIN_ROOT}/package-lock.json" ]; then
    cp "${CLAUDE_PLUGIN_ROOT}/package-lock.json" "$dir/" || exit 1
  fi
  stage_node_modules "$dir"
  stage_dist "$dir"
  # Provision verification — never seal (and so never publish or spawn) a
  # missing entry point.
  if [ ! -f "$dir/dist/coordinator.js" ]; then
    echo "agent-coherence: ${dir}/dist/coordinator.js missing after provisioning; coordinator will not start this session. Next session retries." >&2
    python_backend_hint >&2
    exit 1
  fi
  # The seal, written last. Its ABI and install digest let a later build for
  # this ABI start from this one's node_modules.
  printf '%s %s\n' "$NODE_ABI" "$DEPS_DIGEST" >"$dir/.ok" || exit 1
  NEW_BUILD_DIR=""
  BUILD="${dir##*/}"
}

# Point `current` at build $1. The line is written beside it, then renamed over
# it: rename(2) replaces a regular file atomically, so a reader finds the old
# name or the new, never a partial line. The build named before is marked
# retired, which starts its grace.
publish_build() {
  local name="$1" previous="$published" staged="${POINTER}.$$.tmp"
  rm -f "$BUILDS/$name/.retired"
  [ "$name" = "$previous" ] && return 0
  if ! { printf '%s\n' "$name" >"$staged" && mv -f "$staged" "$POINTER"; } 2>/dev/null; then
    rm -f "$staged"
    echo "agent-coherence: could not publish ${BUILDS}/${name}; hooks keep the build published before, and the coordinator will not start this session. Next session retries." >&2
    exit 1
  fi
  published="$name"
  if [ -n "$previous" ] && [ -d "$BUILDS/$previous" ]; then
    : >"$BUILDS/$previous/.retired"
  fi
}

# Remove the builds no reader can still be loading. Kept: the published build;
# the one retired last, so a flip between two Node majors or plugin versions
# goes back to it without a rebuild; any retired less than BUILD_GRACE_MIN
# ago; and any unfinished one younger than UNFINISHED_BUILD_MIN. .ok goes first, so a removal cut short never
# looks finished. A running coordinator keeps working after its build is
# removed: it loads everything it needs when it starts.
collect_builds() {
  local dir name last_retired
  last_retired="$(ls -t "$BUILDS"/*/.retired 2>/dev/null | head -n 1)"
  for dir in "$BUILDS"/*/; do
    dir="${dir%/}"
    name="${dir##*/}"
    [ -d "$dir" ] || continue
    [ "$name" = "$published" ] && continue
    [ "$dir/.retired" = "$last_retired" ] && continue
    if [ -f "$dir/.ok" ]; then
      # A finished build nothing retired, made by a start that lost a race to
      # publish: its grace runs from when it was sealed, so it never passes
      # for the build retired last.
      if [ ! -f "$dir/.retired" ]; then
        : >"$dir/.retired"
        touch -r "$dir/.ok" "$dir/.retired"
        continue
      fi
      [ -n "$(find "$dir/.retired" -mmin +"$BUILD_GRACE_MIN" 2>/dev/null)" ] || continue
    else
      [ -n "$(find "$dir" -maxdepth 0 -mmin +"$UNFINISHED_BUILD_MIN" 2>/dev/null)" ] || continue
    fi
    rm -f "$dir/.ok"
    rm -rf "$dir" 9>&-
  done
  find "$CLAUDE_PLUGIN_DATA" -maxdepth 1 -name 'current.*.tmp' -mmin +"$STALE_POINTER_TMP_MIN" -exec rm -f {} + 2>/dev/null
}

# Another start held the lock for PROVISION_WAIT_S. Writing anyway would race
# it, so this start runs a finished build for its key if there is one, else,
# to start a coordinator, the published build when it was made for this ABI.
# Otherwise it stops, and the next session retries.
use_build_on_lock_timeout() {
  local usable
  usable="$(find_build "$BUILD_KEY.*")" || usable=""
  if [ -z "$usable" ] && [ "${AGENT_COHERENCE_PROVISION_ONLY:-}" != "1" ]; then
    case "$published" in "$ABI_TAG"-*) build_complete "$published" && usable="$published" ;; esac
  fi
  if [ -z "$usable" ]; then
    echo "agent-coherence: another session start has held ${PROVISION_LOCK} for ${PROVISION_WAIT_S}s and no build for this package and Node ${NODE_VERSION_RAW} is ready; coordinator will not start this session. Next session retries." >&2
    exit 1
  fi
  BUILD="$usable"
  case "$usable" in
    "$BUILD_KEY".*)
      echo "agent-coherence: another session start has held ${PROVISION_LOCK} for ${PROVISION_WAIT_S}s; this session runs the finished build for this package (${usable}). Next session publishes it." >&2
      ;;
    *)
      # Stage 3 keeps any live coordinator, so one started from the older
      # build runs it until it stops.
      echo "agent-coherence: another session start has held ${PROVISION_LOCK} for ${PROVISION_WAIT_S}s and is still building this package; this session uses the build published before it (${usable}). A coordinator started from that build keeps it until it stops: once that start has finished, stop it (kill \"\$(head -n 1 '${PIDFILE}')\") and start a new session to run the new build." >&2
      ;;
  esac
}

# Stages 1-2: have a finished build for BUILD_KEY, published. The common case
# takes no lock and writes nothing.
BUILD=""
read_pointer
if published_is_wanted; then
  BUILD="$published"
else
  acquire_provision_lock
  lock_status=$?
  case "$lock_status" in
    1) use_build_on_lock_timeout ;;
    2) BUILD="$published" ;;
    *)
      if [ "$lock_status" = 3 ]; then
        echo "agent-coherence: nothing here can lock ${PROVISION_LOCK}; provisioning unlocked, into a build directory no other start writes" >&2
      fi
      # A start that waited reads `current` again: the one it waited for most
      # likely built this very key.
      read_pointer
      if ! BUILD="$(find_build "$BUILD_KEY.*")"; then
        # Provisions killed mid-build leave unfinished builds behind.
        collect_builds
        build_new
      fi
      publish_build "$BUILD"
      collect_builds
      release_provision_lock
      ;;
  esac
fi
BUILD_DIR="${BUILDS}/${BUILD}"

# Provision verification — never spawn (or report success for) a missing
# entry point. Before this check, a dist-less package produced an infinite
# MODULE_NOT_FOUND crash loop behind a false "spawned" message.
if [ ! -f "${BUILD_DIR}/dist/coordinator.js" ]; then
  echo "agent-coherence: ${BUILD_DIR}/dist/coordinator.js missing after provisioning; coordinator will not start this session. Next session retries." >&2
  python_backend_hint >&2
  exit 1
fi

# Provision only: a Python-backend session start runs Stages 0-2 so its hooks
# stop running the Node hook client an earlier plugin version installed here
# (#289). It starts no coordinator and stamps no backend.
if [ "${AGENT_COHERENCE_PROVISION_ONLY:-}" = "1" ]; then
  exit 0
fi

# Whether a coordinator holds its lock on server.pid: held, free, or unknown
# when no lock tool here can tell. A coordinator, Node or Python, holds an
# exclusive flock on the file for its whole life, and the kernel drops it when
# the coordinator dies (#217). Each probe takes the lock for an instant, shared
# where it can, as the Python coordinator's own probe does, so two probes do
# not read each other as a coordinator; a coordinator starting at that moment
# retries.
pidfile_lock_state() {
  local status
  # No file, no holder; and flock(1) would create one.
  [ -f "$PIDFILE" ] || { echo free; return; }
  # perl first: it alone tells a held lock (1) from a file system that cannot
  # lock (3), where BusyBox flock(1) exits 1 for both.
  if command -v perl >/dev/null 2>&1; then
    perl -MFcntl=:flock -e 'open(my $fh, "<", $ARGV[0]) or exit 2; exit 0 if flock($fh, LOCK_SH | LOCK_NB); exit($!{EWOULDBLOCK} ? 1 : 3)' "$PIDFILE" 2>/dev/null
    status=$?
    case "$status" in 0) echo free; return ;; 1) echo held; return ;; 3) echo unknown; return ;; esac
  fi
  if command -v flock >/dev/null 2>&1; then
    flock -s -n "$PIDFILE" true 2>/dev/null
    status=$?
    case "$status" in 0) echo free; return ;; 1) echo held; return ;; esac
  fi
  case "${OSTYPE:-}" in
    darwin*)
      # Exclusive only. -k: without it lockf deletes the file once the
      # command has run.
      lockf -k -n -s -t 0 "$PIDFILE" true 2>/dev/null
      status=$?
      case "$status" in 0) echo free; return ;; 75) echo held; return ;; esac
      ;;
  esac
  echo unknown
}

# The pid a server.pid content ($1) publishes as serving: line 1 when line 2
# holds a port and that pid is alive; nothing otherwise. A coordinator that is
# starting has not written its port yet, and one that is stopping has removed it.
serving_pid_in() {
  local pid port
  pid="$(printf '%s\n' "$1" | sed -n 1p)"
  port="$(printf '%s\n' "$1" | sed -n 2p)"
  if [ -n "$pid" ] && [ -n "$port" ] && kill -0 "$pid" 2>/dev/null; then
    printf '%s' "$pid"
  fi
}

# Whether pid $1 is alive and, where ps can say, runs a coordinator: the pid
# in a stale server.pid may since belong to any process.
pid_runs_coordinator() {
  local command_line
  kill -0 "$1" 2>/dev/null || return 1
  # BusyBox ps has no -p; /proc says the same on Linux. Where neither can
  # say, the pid's liveness decides, as before.
  command_line="$(ps -ww -p "$1" -o command= 2>/dev/null)" ||
    command_line="$(tr '\0' ' ' 2>/dev/null <"/proc/$1/cmdline")" ||
    { kill -0 "$1" 2>/dev/null; return; }
  case "$command_line" in
    *dist/coordinator.js*) return 0 ;;
    *) return 1 ;;
  esac
}

# First-provision backend stamp: this bootstrap initialized a VIRGIN workspace
# (no state.db before boot) and a Node coordinator serves it, or at least is
# still alive at the startup deadline below, so the store is Node-owned from
# birth. Record that as the explicit backend selection. Without the stamp, the
# dispatcher's guard (a) (state.db present → python default) would misread the
# Node-born store as an established Python workspace on the NEXT session and
# route to the Python bootstrap — one working session, then silent degrade
# after reboot on exactly the zero-Python machines the Node default exists
# for. An operator's existing selection file is never overwritten.
#
# The stamp runs seconds after the start check, so it tests the name again
# and writes only where nothing is there: the test keeps out a link, dangling
# or not, a FIFO and any file. Under set -C bash creates a missing file
# exclusively and clobbers no regular file, so a regular file, a link to one
# or a dangling link planted since the test is not written through. It opens
# any other existing name without O_EXCL, though: a FIFO, or a link to one,
# planted in that window by the same user can still block the write.
stamp_node_backend() {
  local backend_file="${WORKSPACE}/.coherence/coordinator_backend"
  if [ "$workspace_had_state_db" = "0" ] && [ ! -e "$backend_file" ] && [ ! -L "$backend_file" ]; then
    mkdir -p "${WORKSPACE}/.coherence"
    ( set -C; echo "node" >"$backend_file" ) 2>/dev/null || true
  fi
}

# Another session's coordinator serves this workspace instead of the one
# started here (#217), which exits without touching it. The store is
# Node-owned only if that one is Node's: the Python coordinator's server.pid
# has no backend line.
finish_joined() {
  echo "agent-coherence: $1" >&2
  if [ "$(sed -n 3p "$PIDFILE" 2>/dev/null)" = "backend=node" ]; then
    stamp_node_backend
  fi
  exit 0
}

# Stage 3: is a coordinator already serving this workspace (WORKSPACE/PIDFILE
# resolved up top, before the virgin-store marker)? One holding the lock with
# its port published is. One holding it without a port is starting or
# stopping: a coordinator is started anyway, and the lock decides, so this
# session joins the holder once it serves or takes over once it lets go. A
# Node coordinator started before the lock existed holds none and keeps
# serving after a plugin update, so a live one named by a `backend=node` file
# counts too; with no lock tool at all, any live pid does, as before.
if [ -f "$PIDFILE" ]; then
  EXISTING_PID=$(head -1 "$PIDFILE" 2>/dev/null || echo "")
  lock_state="$(pidfile_lock_state)"
  coordinator_running=0
  if [ "$lock_state" = "held" ]; then
    [ -n "$(serving_pid_in "$(cat "$PIDFILE" 2>/dev/null)")" ] && coordinator_running=1
  elif [ -n "$EXISTING_PID" ]; then
    if [ "$(sed -n 3p "$PIDFILE" 2>/dev/null)" = "backend=node" ]; then
      pid_runs_coordinator "$EXISTING_PID" && coordinator_running=1
    elif [ "$lock_state" = "unknown" ] && kill -0 "$EXISTING_PID" 2>/dev/null; then
      coordinator_running=1
    fi
  fi
  if [ "$coordinator_running" = "1" ]; then
    echo "agent-coherence: coordinator already running${EXISTING_PID:+ (pid=$EXISTING_PID)}" >&2
    exit 0
  fi
  if [ "$lock_state" = "held" ]; then
    echo "agent-coherence: a coordinator holds ${PIDFILE} but serves no port (starting or stopping); starting one that waits for it" >&2
  else
    echo "agent-coherence: stale pid file (pid='${EXISTING_PID}' not running); spawning fresh" >&2
  fi
fi

# Stage 4: spawn the coordinator in a session of its own (node's spawn with
# detached: true calls setsid; macOS ships no setsid(1)), so nothing that
# signals the SessionStart hook's process group, as a hook timeout may,
# reaches the coordinator that later hooks need. The launcher prints the
# coordinator's own pid, also when `node` is a launcher that does not exec.
COORD_LOG="${CLAUDE_PLUGIN_DATA}/coordinator.log"
# Whether the coordinator started here exited because another held the lock,
# as its last log line says; the log is shared by every session's coordinator.
spawned_coordinator_lost() {
  [ -n "$SPAWNED_PID" ] && tail -n 50 "$COORD_LOG" 2>/dev/null | grep -qF "; exiting (pid=${SPAWNED_PID})"
}
launch_coordinator() {
  node -e '
const { spawn } = require("node:child_process");
const { openSync } = require("node:fs");
const [entry, logPath] = process.argv.slice(1);
const log = openSync(logPath, "a");
const child = spawn(process.execPath, [entry], { detached: true, stdio: ["ignore", log, log] });
if (child.pid !== undefined) process.stdout.write(String(child.pid));
child.unref();
' "${BUILD_DIR}/dist/coordinator.js" "$COORD_LOG" 2>>"$COORD_LOG"
}
pidfile_before_spawn="$(cat "$PIDFILE" 2>/dev/null)"
SPAWNED_PID="$(launch_coordinator)"

# Startup gate: wait until a coordinator serves this workspace or ours exits.
# A coordinator writes server.pid naming itself, with its port, once it has
# bound that port, so the workspace is served once server.pid changes to
# publish a live pid. That is ours, or another session's when two start at
# once (#217): ours then waits for the lock and exits, so that session is
# joined, not spawned. Where no lock tool can tell, both serve, as before
# #217, and the session reports its own. A changed file, not just a different
# pid, so a stale file whose pid was reused never counts. Ours exiting is a
# failure unless another coordinator holds the lock: one that has published
# already is joined at once, one still starting is waited for, and one that
# lets go without serving (stopping slower than ours waits for the lock) gets
# one more coordinator started in its place.
#
# A fixed half-second wait was not enough: a coordinator fails start-up only
# after loading its native module and opening state.db, which took 1.3-1.7 s
# under heavy load, so a dying coordinator was reported as spawned, pinned a
# fresh workspace to node below and skipped the ABI self-heal. One still alive
# but not serving at the deadline is warned about and let through: it may
# only be slow. Only the spawn path pays this; a running session exits above.
READY_TIMEOUT_S=10
ready_deadline=$((SECONDS + READY_TIMEOUT_S))
gate_outcome=waiting
relaunched=0
while :; do
  pidfile_now="$(cat "$PIDFILE" 2>/dev/null)"
  serving_pid="$(serving_pid_in "$pidfile_now")"
  if [ "$pidfile_now" != "$pidfile_before_spawn" ] && [ -n "$serving_pid" ]; then
    if [ "$serving_pid" = "$SPAWNED_PID" ] || [ "$(pidfile_lock_state)" = "unknown" ]; then
      gate_outcome=serving
    else
      gate_outcome=joined
    fi
    break
  fi
  if ! kill -0 "$SPAWNED_PID" 2>/dev/null; then
    if [ "$(pidfile_lock_state)" = "held" ]; then
      if [ -n "$serving_pid" ]; then
        gate_outcome=joined
        break
      fi
    elif [ "$relaunched" = "0" ] && spawned_coordinator_lost; then
      echo "agent-coherence: the coordinator holding ${PIDFILE} let go without serving; starting another" >&2
      relaunched=1
      pidfile_before_spawn="$(cat "$PIDFILE" 2>/dev/null)"
      SPAWNED_PID="$(launch_coordinator)"
    else
      gate_outcome=exited
      break
    fi
  fi
  [ "$SECONDS" -ge "$ready_deadline" ] && break
  sleep 0.1
done

if [ "$gate_outcome" = "joined" ]; then
  finish_joined "another coordinator already serves this workspace (pid=${serving_pid}); the one started here (pid=${SPAWNED_PID}) exits"
fi
if [ "$gate_outcome" = "waiting" ] && ! kill -0 "$SPAWNED_PID" 2>/dev/null && [ "$(pidfile_lock_state)" = "held" ]; then
  finish_joined "another coordinator holds ${PIDFILE} but has not started serving after ${READY_TIMEOUT_S}s (see ${COORD_LOG})"
fi
if [ "$gate_outcome" != "serving" ] && ! kill -0 "$SPAWNED_PID" 2>/dev/null; then
  echo "agent-coherence: Node coordinator exited before it started serving; recent ${COORD_LOG}:" >&2
  tail -n 12 "$COORD_LOG" >&2 2>/dev/null || true
  # A NODE_MODULE_VERSION death means the build's node_modules is ABI-stale
  # despite the seal that vouched for it — a hand-restored tree, a seal
  # written before this session's node changed underneath it. Remove the seal
  # so the next session makes a new build instead of crash-looping forever.
  # coordinator.log is every workspace's, so the line may be another
  # coordinator's or an older crash's: the seal goes only when this build's
  # addon does not load here, so an unrelated crash cannot turn into a rebuild
  # every session. Hooks keep running the build meanwhile: they load no
  # native addon.
  if tail -n 40 "$COORD_LOG" 2>/dev/null | grep -q 'NODE_MODULE_VERSION' && ! native_module_loads "$BUILD_DIR"; then
    rm -f "${BUILD_DIR}/.ok"
    echo "agent-coherence: (native-ABI mismatch detected; next session reprovisions node_modules.)" >&2
  fi
  exit 1
fi
if [ "$gate_outcome" = "waiting" ]; then
  echo "agent-coherence: Node coordinator (pid=${SPAWNED_PID}) has not started serving after ${READY_TIMEOUT_S}s; it may still be starting (see ${COORD_LOG})" >&2
fi

stamp_node_backend
echo "agent-coherence: spawned Node coordinator (pid=${SPAWNED_PID}, log=${COORD_LOG})" >&2
