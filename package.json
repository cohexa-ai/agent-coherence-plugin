{
  "name": "agent-coherence-plugin-coordinator",
  "version": "0.5.0",
  "description": "Node coordinator for the agent-coherence Claude Code plugin \u2014 MESI-subset port of the Python coordinator for one-click marketplace install. Coexists with the Python coordinator per coherence.coordinator_backend setting.",
  "private": true,
  "type": "module",
  "main": "dist/coordinator.js",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^25.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --test dist/test/*.test.js",
    "test:src": "tsc && node --test dist/test/*.test.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'tools/**/*.js'",
    "format:check": "prettier --check 'src/**/*.ts' 'tools/**/*.js'"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/uuid": "^11.0.0",
    "better-sqlite3": "^12.11.1",
    "js-yaml": "^4.3.2",
    "uuid": "^14.0.2"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/Cohexa-ai/agent-coherence-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cohexa-ai/agent-coherence-plugin.git"
  },
  "license": "Apache-2.0"
}
